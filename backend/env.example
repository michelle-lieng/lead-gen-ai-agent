# Database Configuration
# For local development: use localhost
# For Docker: docker-compose.yml will override POSTGRESQL_HOST to "db"
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=password
POSTGRESQL_DATABASE=ai_lead_generator

# API Keys
# NOTE: These are NO LONGER required. Users now enter their own OpenAI and Jina
# API keys in the frontend, and those keys are sent per-request to the backend.
# The variables below are optional and only kept as a convenience fallback.
# JINA_API_KEY=your_jina_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# App Configuration
DEBUG=false
LOG_LEVEL=INFO