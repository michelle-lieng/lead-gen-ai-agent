# Database Configuration
# A full connection string wins over the POSTGRESQL_* values below.
# On Supabase use the Transaction pooler URL (port 6543) from Connect.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# For local development: use localhost
# For Docker: docker-compose.yml will override POSTGRESQL_HOST to "db"
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=password
POSTGRESQL_DATABASE=ai_lead_generator

# Access
# The one shared password that opens the app. Nothing answers without it.
APP_PASSWORD=
# Signs sessions; changing it (or the password) signs everyone out. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=

# API Keys (used by the server; nobody enters keys in the browser)
# Needed for searches and columns.
OPENAI_API_KEY=
# Raw Jina key, without the "jina_" prefix. Needed for searches and columns.
JINA_API_KEY=
# Optional: location searches also search Google Maps when this is set.
GOOGLE_PLACES_API_KEY=
# Optional: the OpenAI model for every call. Defaults to gpt-6-luna.
# OPENAI_MODEL=gpt-6-luna
# Optional: agent reasoning effort (none, low, medium, high). Defaults to low.
# OPENAI_REASONING_EFFORT=low

# App Configuration
DEBUG=false
LOG_LEVEL=INFO